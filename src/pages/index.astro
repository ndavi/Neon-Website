---
import { getCollection } from 'astro:content';
import BaseLayout from '../layouts/BaseLayout.astro';
import Header from '../components/Header.astro';
import Description from '../components/Description.astro';
import Footer from '../components/Footer.astro';
import VideoSection from '../components/VideoSection.astro';
import ProjectSection from '../components/ProjectSection.astro';
import Home from '../components/Home.astro';
import ProjectDialog from '../components/ProjectDialog.astro';
import { CATEGORIES, SITE_DESCRIPTION } from '../config/site';

import stageDesignData from '../content/projects/stage-design.json';
import onTourData from '../content/projects/on-tour.json';
import artsNumeriquesData from '../content/projects/arts-numeriques.json';
import conception3dData from '../content/projects/conception-3d.json';

const collectionsData = {
  'stage-design': { collection: await getCollection('stage-design'), json: stageDesignData },
  'on-tour': { collection: await getCollection('on-tour'), json: onTourData },
  'arts-numeriques': { collection: await getCollection('arts-numeriques'), json: artsNumeriquesData },
  'conception-3d': { collection: await getCollection('conception-3d'), json: conception3dData }
};

// Helper to preserve JSON order
const sortByJson = (collection: any[], jsonData: any[]) => {
  const idToOrder = new Map(jsonData.map((item, index) => [item.id, index]));
  return [...collection].sort((a, b) => (idToOrder.get(a.id) ?? 0) - (idToOrder.get(b.id) ?? 0));
};

const sortedCollections = Object.fromEntries(
  Object.entries(collectionsData).map(([id, { collection, json }]) => [
    id, sortByJson(collection, json)
  ])
);
---

<BaseLayout title="Stage Design & Arts Numériques" description={SITE_DESCRIPTION}>
	<div id="app-root" class="app min-h-screen bg-[#dbdbdb]">
    <Home />
    <Header />
    <Description />
    
    <main>
      <div class="w-full">
        {CATEGORIES.map((cat) => (
          <>
            <ProjectSection 
              category={cat}
              projects={sortedCollections[cat.id] || []}
            />
            {cat.id === 'arts-numeriques' && <VideoSection />}
          </>
        ))}
      </div>
    </main>

    <Footer />
  </div>

  <ProjectDialog />
</BaseLayout>
