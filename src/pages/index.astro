---
import { getCollection } from 'astro:content';
import BaseLayout from '../layouts/BaseLayout.astro';
import Header from '../components/Header.astro';
import Description from '../components/Description.astro';
import Footer from '../components/Footer.astro';
import VideoSection from '../components/VideoSection.astro';
import ProjectSection from '../components/ProjectSection.astro';
import Home from '../components/Home.astro';
import ProjectDialog from '../components/ProjectDialog.astro';

const allProjects = await getCollection('projects');

const categories = [
  { 
    id: 'stageDesign',
    name: 'STAGE DESIGN', 
    description: 'Conception et exploitation de scénographies.',
    pictoClass: 'picto-sd'
  },
  { 
    id: 'tour',
    name: 'ON TOUR', 
    description: 'Création lumière & video sur des tournées.',
    pictoClass: 'picto-sd'
  },
  { 
    id: 'artsNumeriques',
    name: 'ARTS NUMERIQUES', 
    description: 'Installations artistiques et création de contenu génératif.',
    pictoClass: 'picto-an'
  },
  {
    id: 'conception3d',
    name: 'CONCEPTION 3D',
    description: 'Réalisation de plans techniques & rendus 3D',
    pictoClass: 'picto-3d'
  }
];
---

<BaseLayout title="Stage Design & Arts Numériques">
	<div id="app-root" class="app min-h-screen bg-[#dbdbdb]">
    <Home />
    <Header />
    <Description />
    
    <main>
      <div class="w-full">
        {categories.map((cat) => {
          const catProjects = allProjects.filter(p => p.data.category === cat.name);
          // Special case: Conception 3D should be AFTER VideoSection in the original layout
          if (cat.id === 'conception3d') return null;
          
          return (
            <ProjectSection 
              id={cat.id}
              name={cat.name}
              description={cat.description}
              pictoClass={cat.pictoClass}
              projects={catProjects}
            />
          );
        })}

        <VideoSection />

        {(() => {
          const cat = categories.find(c => c.id === 'conception3d');
          if (!cat) return null;
          const catProjects = allProjects.filter(p => p.data.category === cat.name);
          return (
            <ProjectSection 
              id={cat.id}
              name={cat.name}
              description={cat.description}
              pictoClass={cat.pictoClass}
              projects={catProjects}
            />
          );
        })()}
      </div>
    </main>

    <Footer />
  </div>

  <ProjectDialog />
</BaseLayout>
