---
import { getCollection } from 'astro:content';
import BaseLayout from '../layouts/BaseLayout.astro';
import Header from '../components/Header.astro';
import Description from '../components/Description.astro';
import Footer from '../components/Footer.astro';
import VideoSection from '../components/VideoSection.astro';
import ProjectSection from '../components/ProjectSection.astro';
import Home from '../components/Home.astro';
import ProjectDialog from '../components/ProjectDialog.astro';
import { CATEGORIES, SITE_DESCRIPTION } from '../config/site';

const allProjects = await getCollection('projects');
---

<BaseLayout title="Stage Design & Arts Numériques" description={SITE_DESCRIPTION}>
	<div id="app-root" class="app min-h-screen bg-[#dbdbdb]">
    <Home />
    <Header />
    <Description />
    
    <main>
      <div class="w-full">
        {CATEGORIES.map((cat) => {
          const catProjects = allProjects
            .filter(p => p.data.category === cat.name)
            .sort((a, b) => new Date(b.data.date).getTime() - new Date(a.data.date).getTime());
          
          return (
            <>
              <ProjectSection 
                category={cat}
                projects={catProjects}
              />
              {cat.id === 'arts-numeriques' && <VideoSection />}
            </>
          );
        })}
      </div>
    </main>

    <Footer />
  </div>

  <ProjectDialog />
</BaseLayout>
