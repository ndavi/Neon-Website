---
import { getCollection } from 'astro:content';
import BaseLayout from '../layouts/BaseLayout.astro';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import ProjectCard from '../components/ProjectCard.astro';

const allProjects = await getCollection('projects');

const categories = [
  { 
    name: 'STAGE DESIGN', 
    description: 'Conception et exploitation de scénographies.' 
  },
  { 
    name: 'ON TOUR', 
    description: 'Création lumière & video sur des tournées.' 
  },
  { 
    name: 'ARTS NUMERIQUES', 
    description: 'Installations artistiques et création de contenu génératif.' 
  },
  { 
    name: 'CONCEPTION 3D', 
    description: 'Réalisation de plans techniques & rendus 3D.' 
  }
];
---

<BaseLayout title="Stage Design & Arts Numériques">
	<div id="app-root" class="app min-h-screen bg-[#dbdbdb]">
    <Header />
    
    <main>
      <div class="w-full">
        {categories.map((cat) => {
          const catProjects = allProjects.filter(p => p.data.category === cat.name);
          return (
            <section id={cat.name} class={`${cat.name.toLowerCase().replace(" ", "-")} py-10`}>
              <div class="headercontainer">
                <h2 class="section-title uppercase">{cat.name}</h2>
                <div class={`picto-${cat.name === 'STAGE DESIGN' ? 'sd' : cat.name === 'ARTS NUMERIQUES' ? 'an' : cat.name === 'CONCEPTION 3D' ? '3d' : 'v'}`}>
                  <!-- Picto placeholder logic if needed, but original uses relative positioning -->
                </div>
                <hr class="section-hr mx-auto" />
              </div>
              <p class="section-description">{cat.description}</p>
              
              <div class="photos">
                {catProjects.map((project) => (
                  <ProjectCard 
                    title={project.data.title}
                    description={project.data.description || ""}
                    coverImage={project.data.coverImage}
                    srcSmall={project.data.srcSmall}
                    credit={project.data.credit || ""}
                    lienCredit={project.data.lienCredit || ""}
                    alt={project.data.alt || ""}
                    tag={project.data.tag || ""}
                  />
                ))}
              </div>
            </section>
          );
        })}
      </div>

      <!-- Contact section -->
      <section id="contact" class="contact py-20 mt-20">
        <div class="max-w-4xl mx-auto">
          <h2 class="text-3xl font-bold mb-10 uppercase">Contact</h2>
          <div class="flex flex-col md:flex-row justify-center gap-10 md:gap-20">
            <div class="contact-section">
              <p class="font-bold mb-2">EMAIL</p>
              <a href="mailto:contact@neon-live.fr">contact@neon-live.fr</a>
            </div>
            <div class="contact-section">
              <p class="font-bold mb-2">TELEPHONE</p>
              <p>+33 6 32 63 23 30</p>
              <p>+33 6 01 45 16 44</p>
            </div>
          </div>
        </div>
      </section>
    </main>

    <Footer />
  </div>

  <!-- Dialog / Modal -->
  <dialog id="project-dialog" class="dialog">
    <div id="dialog-content" class="flex flex-col items-center w-full">
      <img id="modal-image" src="" alt="" class="max-h-[75vh] object-contain w-[85%]" />
      <div class="text text-white mt-4">
        <h2 id="modal-title" class="title"></h2>
        <div id="modal-description" class="description"></div>
        <div class="credit">
          Crédit photo : <a id="modal-credit-link" href="" target="_blank" rel="noreferrer"></a>
        </div>
      </div>
    </div>
  </dialog>

  <script>
    const dialog = document.getElementById('project-dialog') as HTMLDialogElement;
    const appRoot = document.getElementById('app-root');
    const triggers = document.querySelectorAll('.project-trigger');
    
    const modalImg = document.getElementById('modal-image') as HTMLImageElement;
    const modalTitle = document.getElementById('modal-title');
    const modalDesc = document.getElementById('modal-description');
    const modalCreditLink = document.getElementById('modal-credit-link') as HTMLAnchorElement;

    triggers.forEach(trigger => {
      trigger.addEventListener('click', () => {
        const data = (trigger as HTMLElement).dataset;
        
        if (modalImg) modalImg.src = data.image || '';
        if (modalTitle) modalTitle.textContent = data.title || '';
        if (modalDesc) modalDesc.textContent = data.description || '';
        if (modalCreditLink) {
          modalCreditLink.href = data.lienCredit || '';
          modalCreditLink.textContent = data.credit || '';
        }

        dialog?.showModal();
        appRoot?.classList.remove('app');
        appRoot?.classList.add('app-opacity');
      });
    });

    dialog?.addEventListener('click', (e) => {
      if (e.target === dialog) {
        closeDialog();
      }
    });

    // Original behavior: clicking anywhere in dialog closes it
    dialog?.addEventListener('click', () => {
      closeDialog();
    });

    function closeDialog() {
      dialog?.close();
      appRoot?.classList.remove('app-opacity');
      appRoot?.classList.add('app');
    }

    window.addEventListener('keydown', (e) => {
      if (e.key === 'Escape' && dialog?.open) {
        closeDialog();
      }
    });
  </script>
</BaseLayout>

<style>
  .app-opacity {
    background: rgba(0, 0, 0, 0.95) !important;
  }
  .app-opacity img {
    opacity: 0.25;
  }
  .app-opacity .text-black {
    color: rgba(255, 255, 255, 0.2) !important;
  }
  /* Ensure the dialog is visible and styled correctly */
  dialog::backdrop {
    background: transparent;
  }
  .dialog {
    background: none;
    border: none;
    color: white;
    max-width: 100vw;
    max-height: 100vh;
    width: 100%;
    height: 100%;
    margin: 0;
    padding: 10px;
    display: none;
    flex-direction: column;
    align-items: center;
    justify-content: center;
  }
  .dialog[open] {
    display: flex;
  }
</style>
