---
import { getCollection } from 'astro:content';
import BaseLayout from '../../layouts/BaseLayout.astro';
import Header from '../../components/Header.astro';
import Description from '../../components/Description.astro';
import Footer from '../../components/Footer.astro';
import VideoSection from '../../components/VideoSection.astro';
import ProjectSection from '../../components/ProjectSection.astro';
import Home from '../../components/Home.astro';
import Lightbox from '../../components/Lightbox.astro';
import { CATEGORIES } from '../../config/site';
import { ui } from '../../i18n/ui';
import { useTranslations, sortProjects } from '../../i18n/utils';

export function getStaticPaths() {
  return [{ params: { lang: 'fr' } }, { params: { lang: 'en' } }];
}

const { lang } = Astro.params;
const t = useTranslations(lang as keyof typeof ui);

const stageDesign = await getCollection('stage-design');
const onTour = await getCollection('on-tour');
const artsNumeriques = await getCollection('arts-numeriques');
const conception3d = await getCollection('conception-3d');

const sortedCollections = {
  'stage-design': sortProjects(stageDesign),
  'on-tour': sortProjects(onTour),
  'arts-numeriques': sortProjects(artsNumeriques),
  'conception-3d': sortProjects(conception3d),
};
---

<BaseLayout
  title={t('seo.title')}
  description={t('seo.description')}
  lang={lang}
>
  <div id="app-root" class="app min-h-screen bg-[#0a0a0b]">
    <Home />
    <Header />
    <Description />

    <main class="pt-[70px] max-w-[1380px] mx-auto px-[clamp(20px,5vw,64px)]">
      <div class="w-full">
        {
          CATEGORIES.map((cat, i) => (
            <>
              <ProjectSection
                category={cat}
                projects={
                  sortedCollections[cat.id as keyof typeof sortedCollections] ||
                  []
                }
                index={i}
              />
              {cat.id === 'arts-numeriques' && <VideoSection />}
            </>
          ))
        }
      </div>
    </main>

    <Lightbox />
    <Footer />
  </div>
</BaseLayout>
