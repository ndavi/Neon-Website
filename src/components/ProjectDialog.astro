---
import { getLangFromUrl, useTranslations } from '../i18n/utils';

const lang = getLangFromUrl(Astro.url);
const t = useTranslations(lang);
---
<dialog id="project-dialog" class="dialog" data-lang={lang}>
  <!-- Navigation Buttons -->
  <button id="prev-project" class="nav-button prev" aria-label={t('project.prev')}>
    <svg viewBox="0 0 24 24" width="40" height="40" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><polyline points="15 18 9 12 15 6"></polyline></svg>
  </button>
  
  <button id="next-project" class="nav-button next" aria-label={t('project.next')}>
    <svg viewBox="0 0 24 24" width="40" height="40" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><polyline points="9 18 15 12 9 6"></polyline></svg>
  </button>

  <div id="dialog-content" class="flex flex-col items-center w-full outline-none">
    <div class="w-full flex items-center justify-center min-h-[40vh] lg:min-h-[60vh] relative">
      <div id="modal-loader" class="loader"></div>
      <img id="modal-image" src="" alt="" class="max-h-[75vh] object-contain w-[95%] lg:w-[85%] transition-opacity duration-300 ease-in-out opacity-0" />
    </div>
    <div class="text mt-4 max-w-4xl px-4 pointer-events-auto">
      <h2 id="modal-title" class="title"></h2>
      <div id="modal-description" class="description mb-4"></div>
      <div class="credit">
        {t('project.credit')} <a id="modal-credit-link" href="" target="_blank" rel="noreferrer" aria-label="Lien vers le crédit photo"></a>
      </div>
    </div>
  </div>
</dialog>

<script>
  class ProjectCarousel {
    private dialog: HTMLDialogElement;
    private modalImg: HTMLImageElement;
    private modalLoader: HTMLElement;
    private modalTitle: HTMLElement;
    private modalDesc: HTMLElement;
    private modalCreditLink: HTMLAnchorElement;
    private prevBtn: HTMLButtonElement;
    private nextBtn: HTMLButtonElement;
    private currentIndex: number = -1;
    private triggers: HTMLElement[] = [];
    private isLoading: boolean = false;
    private lang: string;

    constructor() {
      this.dialog = document.getElementById('project-dialog') as HTMLDialogElement;
      this.modalImg = document.getElementById('modal-image') as HTMLImageElement;
      this.modalLoader = document.getElementById('modal-loader')!;
      this.modalTitle = document.getElementById('modal-title')!;
      this.modalDesc = document.getElementById('modal-description')!;
      this.modalCreditLink = document.getElementById('modal-credit-link') as HTMLAnchorElement;
      this.prevBtn = document.getElementById('prev-project') as HTMLButtonElement;
      this.nextBtn = document.getElementById('next-project') as HTMLButtonElement;
      this.lang = this.dialog.dataset.lang || 'fr';

      this.init();
    }

    private init() {
      this.setupGlobalListeners();
      this.setupNavigationListeners();
    }

    private setupGlobalListeners() {
      document.addEventListener('click', (e) => {
        const trigger = (e.target as HTMLElement).closest('.project-trigger') as HTMLElement;
        if (trigger) {
          this.refreshTriggers();
          this.open(this.triggers.indexOf(trigger));
        }
      });

      this.dialog.addEventListener('mousedown', (e) => {
        if (!(e.target as HTMLElement).closest('.nav-button')) this.close();
      });

      window.addEventListener('keydown', (e) => {
        if (!this.dialog.open || this.isLoading) return;
        if (e.key === 'ArrowLeft') this.navigate(-1);
        else if (e.key === 'ArrowRight') this.navigate(1);
        else if (e.key === 'Escape') this.close();
      });

      this.dialog.addEventListener('close', () => {
        document.body.style.overflow = '';
      });
    }

    private setupNavigationListeners() {
      this.prevBtn?.addEventListener('click', (e) => {
        e.stopPropagation();
        if (!this.isLoading) this.navigate(-1);
      });

      this.nextBtn?.addEventListener('click', (e) => {
        e.stopPropagation();
        if (!this.isLoading) this.navigate(1);
      });
    }

    private refreshTriggers() {
      this.triggers = Array.from(document.querySelectorAll('.project-trigger'));
    }

    private getLocalized(val: string | undefined): string {
      if (!val) return '';
      if (!val.startsWith('{')) return val;
      
      try {
        const obj = JSON.parse(val);
        return obj[this.lang] || obj['fr'] || '';
      } catch {
        return val;
      }
    }

    private setLoadingState(isLoading: boolean) {
      this.isLoading = isLoading;
      const pointerEvents = isLoading ? 'none' : 'auto';
      
      this.prevBtn.style.pointerEvents = pointerEvents;
      this.nextBtn.style.pointerEvents = pointerEvents;
      
      if (isLoading) {
        this.modalImg.style.opacity = '0';
        this.modalLoader.style.display = 'block';
      } else {
        this.modalImg.style.opacity = '1';
        this.modalLoader.style.display = 'none';
      }
    }

    private updateContent(index: number) {
      if (index < 0 || index >= this.triggers.length) return;
      
      this.currentIndex = index;
      const data = this.triggers[this.currentIndex].dataset;
      
      this.setLoadingState(true);

      const onDone = () => this.setLoadingState(false);
      this.modalImg.onload = onDone;
      this.modalImg.onerror = onDone;

      this.modalImg.src = data.image || '';
      if (this.modalImg.complete) onDone();

      const title = this.getLocalized(data.title);
      this.modalImg.alt = this.getLocalized(data.alt) || title;
      this.modalTitle.textContent = title;
      this.modalDesc.textContent = this.getLocalized(data.description);
      this.modalCreditLink.href = data.lienCredit || '';
      this.modalCreditLink.textContent = data.credit || '';
    }

    public open(index: number) {
      this.dialog.showModal();
      this.updateContent(index);
      document.body.style.overflow = 'hidden';
    }

    public navigate(direction: number) {
      const newIndex = (this.currentIndex + direction + this.triggers.length) % this.triggers.length;
      this.updateContent(newIndex);
    }

    public close() {
      this.dialog.close();
    }
  }
  new ProjectCarousel();
</script>

<style>
  dialog::backdrop {
    background: rgba(0, 0, 0, 0.95);
    backdrop-filter: blur(5px);
  }
  
  .dialog {
    background: none;
    border: none;
    color: white;
    max-width: 100vw;
    max-height: 100vh;
    width: 100%;
    height: 100%;
    margin: 0;
    padding: 0;
    display: none;
    flex-direction: column;
    align-items: center;
    justify-content: center;
    z-index: 100;
    overflow: hidden;
  }
  
  .dialog[open] {
    display: flex;
  }

  .nav-button {
    position: fixed;
    top: 50%;
    transform: translateY(-50%);
    background: rgba(255, 255, 255, 0.1);
    color: white;
    border: none;
    border-radius: 50%;
    width: 60px;
    height: 60px;
    display: flex;
    align-items: center;
    justify-content: center;
    cursor: pointer;
    transition: all 0.2s;
    z-index: 110;
    user-select: none;
    -webkit-tap-highlight-color: transparent;
  }

  #modal-image {
    user-select: none;
    -webkit-user-drag: none;
  }

  .nav-button:hover {
    background: rgba(255, 255, 255, 0.3);
    scale: 1.1;
  }

  .nav-button.prev { left: 20px; }
  .nav-button.next { right: 20px; }

  .loader {
    display: none;
    width: 50px;
    height: 50px;
    border: 3px solid rgba(255,255,255,.1);
    border-radius: 50%;
    border-top-color: #fff;
    animation: spin 1s linear infinite;
    position: absolute;
    top: 50%;
    left: 50%;
    margin-top: -25px;
    margin-left: -25px;
    z-index: 5;
  }

  @keyframes spin {
    to { transform: rotate(360deg); }
  }

  @media (max-width: 768px) {
    .nav-button {
      width: 45px;
      height: 45px;
      background: rgba(0, 0, 0, 0.5);
    }
    .nav-button.prev { left: 10px; }
    .nav-button.next { right: 10px; }
  }

  .dialog .title {
    font-weight: 700;
    text-transform: uppercase;
    font-size: 2rem;
    margin: 0;
    margin-top: 4%;
    text-align: center;
  }

  .dialog .description {
    text-align: center;
    font-weight: 300;
    font-size: 1.3rem;
  }

  .dialog .credit {
    text-align: center;
    font-weight: 100;
  }

  .dialog a {
    font-style: italic;
    text-decoration: underline;
  }
</style>
