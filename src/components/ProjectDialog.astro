---
---
<dialog id="project-dialog" class="dialog">
  <!-- Navigation Buttons -->
  <button id="prev-project" class="nav-button prev" aria-label="Projet précédent">
    <svg viewBox="0 0 24 24" width="40" height="40" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><polyline points="15 18 9 12 15 6"></polyline></svg>
  </button>
  
  <button id="next-project" class="nav-button next" aria-label="Projet suivant">
    <svg viewBox="0 0 24 24" width="40" height="40" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><polyline points="9 18 15 12 9 6"></polyline></svg>
  </button>

  <div id="dialog-content" class="flex flex-col items-center w-full outline-none">
    <div class="w-full flex items-center justify-center min-h-[40vh] lg:min-h-[60vh]">
      <img id="modal-image" src="" alt="Détail du projet" class="max-h-[75vh] object-contain w-[95%] lg:w-[85%] transition-opacity duration-300 ease-in-out opacity-0" />
    </div>
    <div class="text mt-4 max-w-4xl px-4 pointer-events-auto">
      <h2 id="modal-title" class="title">Détails du projet</h2>
      <div id="modal-description" class="description mb-4"></div>
      <div class="credit">
        Crédit photo : <a id="modal-credit-link" href="" target="_blank" rel="noreferrer" aria-label="Lien vers le crédit photo"></a>
      </div>
    </div>
  </div>
</dialog>

<script>
  const dialog = document.getElementById('project-dialog') as HTMLDialogElement;
  const triggers = document.querySelectorAll('.project-trigger');
  
  const modalImg = document.getElementById('modal-image') as HTMLImageElement;
  const modalTitle = document.getElementById('modal-title');
  const modalDesc = document.getElementById('modal-description');
  const modalCreditLink = document.getElementById('modal-credit-link') as HTMLAnchorElement;
  
  const prevBtn = document.getElementById('prev-project');
  const nextBtn = document.getElementById('next-project');

  let currentIndex = -1;
  const allTriggers = Array.from(document.querySelectorAll('.project-trigger'));

  function updateModalContent(index: number) {
    if (index < 0 || index >= allTriggers.length) return;
    
    currentIndex = index;
    const trigger = allTriggers[currentIndex] as HTMLElement;
    const data = trigger.dataset;
    
    if (modalImg) {
      modalImg.style.opacity = '0';
      modalImg.onload = () => { modalImg.style.opacity = '1'; };
      modalImg.src = data.image || '';
      modalImg.alt = data.alt || data.title || 'Détail du projet';
    }
    if (modalTitle) modalTitle.textContent = data.title || '';
    if (modalDesc) modalDesc.textContent = data.description || '';
    if (modalCreditLink) {
      modalCreditLink.href = data.lienCredit || '';
      modalCreditLink.textContent = data.credit || '';
    }
  }

  triggers.forEach((trigger, index) => {
    trigger.addEventListener('click', (e) => {
      e.stopPropagation();
      updateModalContent(index);
      dialog?.showModal();
      document.body.style.overflow = 'hidden';
    });
  });

  prevBtn?.addEventListener('click', (e) => {
    e.stopPropagation();
    const newIndex = (currentIndex - 1 + allTriggers.length) % allTriggers.length;
    updateModalContent(newIndex);
  });

  nextBtn?.addEventListener('click', (e) => {
    e.stopPropagation();
    const newIndex = (currentIndex + 1) % allTriggers.length;
    updateModalContent(newIndex);
  });

  // Close on any click within the dialog, BUT ensure we can still click navigation buttons
  dialog?.addEventListener('mousedown', (event) => {
    const target = event.target as HTMLElement;
    // If we click a navigation button or its SVG children, don't close
    if (target.closest('.nav-button')) {
      return;
    }
    closeDialog();
  });

  function closeDialog() {
    dialog?.close();
    document.body.style.overflow = '';
  }

  window.addEventListener('keydown', (e) => {
    if (!dialog?.open) return;
    
    if (e.key === 'ArrowLeft') {
      prevBtn?.click();
    } else if (e.key === 'ArrowRight') {
      nextBtn?.click();
    } else if (e.key === 'Escape') {
      closeDialog();
    }
  });

  dialog?.addEventListener('close', () => {
    document.body.style.overflow = '';
  });
</script>

<style>
  dialog::backdrop {
    background: rgba(0, 0, 0, 0.95);
    backdrop-filter: blur(5px);
  }
  
  .dialog {
    background: none;
    border: none;
    color: white;
    max-width: 100vw;
    max-height: 100vh;
    width: 100%;
    height: 100%;
    margin: 0;
    padding: 0;
    display: none;
    flex-direction: column;
    align-items: center;
    justify-content: center;
    z-index: 100;
    overflow: hidden;
  }
  
  .dialog[open] {
    display: flex;
  }

  .nav-button {
    position: fixed;
    top: 50%;
    transform: translateY(-50%);
    background: rgba(255, 255, 255, 0.1);
    color: white;
    border: none;
    border-radius: 50%;
    width: 60px;
    height: 60px;
    display: flex;
    align-items: center;
    justify-content: center;
    cursor: pointer;
    transition: all 0.2s;
    z-index: 110;
    user-select: none; /* Prevent highlighting */
    -webkit-tap-highlight-color: transparent; /* Remove mobile blue highlight */
  }

  #modal-image {
    user-select: none;
    -webkit-user-drag: none; /* Prevent ghost image when dragging accidentally */
  }

  .nav-button:hover {
    background: rgba(255, 255, 255, 0.3);
    scale: 1.1;
  }

  .nav-button.prev { left: 20px; }
  .nav-button.next { right: 20px; }

  @media (max-width: 768px) {
    .nav-button {
      width: 45px;
      height: 45px;
      background: rgba(0, 0, 0, 0.5); /* Plus visible sur mobile */
    }
    .nav-button.prev { left: 10px; }
    .nav-button.next { right: 10px; }
  }

  .dialog .title {
    font-weight: 700;
    text-transform: uppercase;
    font-size: 2rem;
    margin: 0;
    margin-top: 4%;
    text-align: center;
  }

  .dialog .description {
    text-align: center;
    font-weight: 300;
    font-size: 1.3rem;
  }

  .dialog .credit {
    text-align: center;
    font-weight: 100;
  }

  .dialog a {
    font-style: italic;
    text-decoration: underline;
  }
</style>
