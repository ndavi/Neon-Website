---
import { Picture } from 'astro:assets';
import { getLangFromUrl, useTranslations } from '../i18n/utils';

const lang = getLangFromUrl(Astro.url);
const t = useTranslations(lang);
---
<section class="home">
  <Picture 
    src="/img/neon-main-2.jpeg" 
    alt="neon-tapage" 
    width={1920} 
    height={1078} 
    class="home-image" 
    loading="eager" 
    formats={['avif', 'webp']}
  />
  <div class="home-text">
    <h1 class="sr-only">{t('home.sr-only')}</h1>
    <Picture 
      src="/img/neonAssets/neon-noir-baseline.png" 
      alt="logo-neon" 
      width={800} 
      height={358} 
      class="home-logo" 
      style="width: 60vw; max-width: 800px;" 
      loading="eager" 
      formats={['avif', 'webp']}
    />
  </div>
  <div class="arrow-content cursor-pointer" id="home-arrow">
    <svg id="more-arrows" version="1.1" xmlns="http://www.w3.org/2000/svg" xmlns:xlink="http://www.w3.org/1999/xlink" x="0px" y="0px" viewBox="0 0 75 65" style="enable-background:new 0 0 75 65;" xml:space="preserve">
      <polygon class="arrow-middle" points="37.6,45.8 0.8,18.7 4.4,16.4 37.6,41.2 71.2,16.4 74.5,18.7 "></polygon>
      <polygon class="arrow-top" points="37.6,27.9 1.8,1.3 3.3,0 37.6,25.3 71.9,0 73.7,1.3 "></polygon>
    </svg>
  </div>
</section>

<script>
  const homeArrow = document.getElementById('home-arrow');
  const isMobile = window.matchMedia('(max-width: 1024px)');

  homeArrow?.addEventListener('click', () => {
    // If mobile, target intro-text directly, otherwise use the header anchor
    const targetId = isMobile.matches ? 'intro-text' : 'description';
    const targetElement = document.getElementById(targetId);
    targetElement?.scrollIntoView({ behavior: 'smooth', block: 'start' });
  });
</script>

<style>
  .home {
    position: relative;
    width: 100vw;
    height: 100vh;
    display: flex;
    flex-direction: row;
    flex-wrap: wrap;
    z-index: 1; /* Ensure basic layering */
  }

  .home-image {
    object-fit: cover;
    width: 100vw;
    height: 100vh;
    position: absolute;
    z-index: -1; /* Background */
  }

  .home-logo {
    display: block;
    margin: 0px auto;
    position: relative;
  }

  .home-text {
    text-align: center;
    justify-content: center;
    position: absolute;
    left: 0;
    right: 0;
    padding-top: 25vh;
  }

  .arrow-content {
    left: 50vw;
    position: absolute;
    bottom: 5%; /* Use bottom instead of top for mobile viewport stability */
    transform: translate(-50%, 0);
    z-index: 10; /* Ensure on top of everything */
    filter: drop-shadow(0px 0px 5px rgba(0,0,0,0.3)); /* Subtle shadow for white-on-bright visibility */
  }

  #more-arrows {
    height: 65px;
    width: 75px;
    display: block;
  }

  #more-arrows polygon {
    fill: #FFF;
    transition: all .6s ease-out;
  }

  .arrow-middle {
    opacity: .75;
  }

  .arrow-top {
    opacity: .5;
  }

  #more-arrows:hover polygon {
    fill: #FFF;
    transition: all .5s ease-out;
  }

  #more-arrows:hover .arrow-top {
    transform: translateY(18px);
  }
</style>
