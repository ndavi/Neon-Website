---
import { Image } from 'astro:assets';
---
<section class="home">
  <Image src="/img/neon-main-2.jpeg" alt="neon-tapage" width={1920} height={1078} class="home-image" loading="eager" />
  <div class="home-text">
    <Image src="/img/neonAssets/neon-noir-baseline.png" alt="logo-neon" width={800} height={358} class="home-logo" style="width: 60vw; max-width: 800px;" loading="eager" />
  </div>
  <div class="arrow-content cursor-pointer" id="home-arrow">
...
      <polygon class="arrow-top" points="37.6,27.9 1.8,1.3 3.3,0 37.6,25.3 71.9,0 73.7,1.3 "></polygon>
      <polygon class="arrow-middle" points="37.6,45.8 0.8,18.7 4.4,16.4 37.6,41.2 71.2,16.4 74.5,18.7 "></polygon>
    </svg>
  </div>
</section>

<script>
  const homeArrow = document.getElementById('home-arrow');
  homeArrow?.addEventListener('click', () => {
    const descElement = document.getElementById('description');
    descElement?.scrollIntoView({ behavior: 'smooth', block: 'start' });
  });
</script>

<style>
  .home {
    position: relative;
    width: 100vw;
    height: 100vh;
    display: flex;
    flex-direction: row;
    flex-wrap: wrap;
  }

  .home-image {
    object-fit: cover;
    width: 100vw;
    height: 100vh;
    position: absolute;
  }

  .home-logo {
    display: block;
    margin: 0px auto;
    position: relative;
  }

  .home-text {
    text-align: center;
    justify-content: center;
    position: absolute;
    left: 0;
    right: 0;
    padding-top: 25vh;
  }

  .arrow-content {
    left: 50vw;
    position: absolute;
    top: 90vh;
    transform: translate(-50%, -50%);
  }

  #more-arrows {
    height: 65px;
    width: 75px;
  }

  #more-arrows polygon {
    fill: #FFF;
    transition: all .6s ease-out;
  }

  .arrow-middle {
    opacity: .75;
  }

  .arrow-top {
    opacity: .5;
  }

  #more-arrows:hover polygon {
    fill: #FFF;
    transition: all .5s ease-out;
  }

  #more-arrows:hover .arrow-top {
    transform: translateY(18px);
  }
</style>
