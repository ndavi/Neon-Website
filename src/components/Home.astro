---
import { getLangFromUrl, useTranslations } from '../i18n/utils';
import neonMain from '../assets/img/neon-main-2.jpeg';
import neonLogo from '../assets/img/neonAssets/neon-white-sans-baseline.png';

const lang = getLangFromUrl(Astro.url);
const t = useTranslations(lang);
---

<section class="hero">
  <img
    src={neonMain.src}
    alt="NEON — Scénographie live"
    width={neonMain.width}
    height={neonMain.height}
    class="hero-bg"
    loading="eager"
  />
  <div class="hero-overlay" aria-hidden="true"></div>

  <div class="hero-content">
    <h1 class="sr-only">{t('home.sr-only')}</h1>
    <img
      src={neonLogo.src}
      alt="NEON — Stage Design & Arts Numériques"
      width={neonLogo.width}
      height={neonLogo.height}
      class="hero-logo"
      loading="eager"
    />
    <p class="hero-tagline">Lyon — France</p>
  </div>

  <button class="hero-scroll" id="home-arrow" aria-label={t('home.sr-only')}>
    <span class="scroll-hint">DÉCOUVRIR</span>
    <svg
      width="26"
      height="16"
      viewBox="0 0 26 16"
      fill="none"
      aria-hidden="true"
    >
      <path
        d="M2 2L13 13L24 2"
        stroke="#ffffff"
        stroke-width="2"
        stroke-linecap="round"
        stroke-linejoin="round"></path>
    </svg>
  </button>
</section>

<script>
  import { gsap } from 'gsap';

  function initHome() {
    const hero = document.querySelector('.hero') as HTMLElement;
    const bg = document.querySelector('.hero-bg') as HTMLElement;

    // Fix mobile viewport height jump
    function setHeroHeight() {
      if (hero && window.matchMedia('(max-width: 768px)').matches) {
        // Set fixed height on load to prevent resize jumps when address bar hides
        hero.style.height = `${window.innerHeight}px`;
      } else if (hero) {
        hero.style.height = '';
      }
    }
    setHeroHeight();
    window.addEventListener('orientationchange', () => {
      setTimeout(setHeroHeight, 200);
    });

    // 1. Mouse Parallax (Desktop Only)
    if (hero && bg && window.matchMedia('(pointer: fine)').matches) {
      const xTo = gsap.quickTo(bg, 'x', { duration: 0.6, ease: 'power3' });
      const yTo = gsap.quickTo(bg, 'y', { duration: 0.6, ease: 'power3' });

      gsap.set(bg, { scale: 1.05 });

      hero.addEventListener('mousemove', (e) => {
        const rect = hero.getBoundingClientRect();
        const xPos = (e.clientX - rect.left) / rect.width - 0.5;
        const yPos = (e.clientY - rect.top) / rect.height - 0.5;

        xTo(xPos * -30);
        yTo(yPos * -30);
      });

      hero.addEventListener('mouseleave', () => {
        xTo(0);
        yTo(0);
      });
    }

    // 2. Entrance Animations
    const logo = document.querySelector('.hero-logo');
    const tagline = document.querySelector('.hero-tagline');
    const arrow = document.querySelector('.hero-scroll');

    // Hide initially to prevent FOUC before animation starts
    gsap.set([logo, tagline, arrow], { opacity: 0 });

    function playEntrance() {
      const tl = gsap.timeline();
      tl.fromTo(
        logo,
        { opacity: 0, y: 50 },
        { opacity: 1, y: 0, duration: 1.2, ease: 'power3.out' }
      )
        .fromTo(
          tagline,
          { opacity: 0, letterSpacing: '0.1em' },
          {
            opacity: 1,
            letterSpacing: '0.46em',
            duration: 1.2,
            ease: 'power3.out',
          },
          '-=0.8'
        )
        .fromTo(arrow, { opacity: 0 }, { opacity: 1, duration: 1 }, '-=0.6');
    }

    // Run entrance animation immediately
    playEntrance();

    // Scroll Arrow Logic
    const btn = document.getElementById('home-arrow');
    btn?.addEventListener('click', () => {
      const target =
        document.getElementById('description') ??
        document.getElementById('stage-design');
      if (target) {
        const y = target.getBoundingClientRect().top + window.scrollY - 72;
        window.scrollTo({ top: y, behavior: 'smooth' });
      }
    });
  }

  document.addEventListener('DOMContentLoaded', initHome);
  document.addEventListener('astro:after-swap', initHome);
</script>

<style>
  .hero {
    position: relative;
    width: 100vw;
    height: 100vh;
    height: 100svh;
    display: flex;
    align-items: center;
    justify-content: center;
    overflow: hidden;
  }

  .hero-bg {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    object-fit: cover;
    z-index: 0;
  }

  .hero-overlay {
    position: absolute;
    inset: 0;
    z-index: 1;
    background: radial-gradient(
      120% 90% at 50% 38%,
      rgba(10, 10, 11, 0) 30%,
      rgba(10, 10, 11, 0.55) 78%,
      rgba(10, 10, 11, 0.95) 100%
    );
  }

  .hero-content {
    position: relative;
    z-index: 2;
    display: flex;
    flex-direction: column;
    align-items: center;
    text-align: center;
    padding: 0 24px;
  }

  .hero-logo {
    width: min(560px, 64vw);
    height: auto;
    display: block;
    filter: drop-shadow(0 8px 40px rgba(0, 0, 0, 0.6));
  }

  .hero-tagline {
    margin: 34px 0 0;
    color: rgba(255, 255, 255, 0.62);
    font-weight: 300;
    font-size: clamp(12px, 1.2vw, 15px);
    letter-spacing: 0.46em;
    text-transform: uppercase;
  }

  .hero-scroll {
    position: absolute;
    bottom: 34px;
    left: 50%;
    transform: translateX(-50%);
    z-index: 3;
    background: none;
    border: 0;
    cursor: pointer;
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: 8px;
    padding: 0;
  }

  .scroll-hint {
    color: rgba(255, 255, 255, 0.6);
    font-size: 10.5px;
    letter-spacing: 0.3em;
    font-weight: 500;
    font-family: 'M PLUS Rounded 1c', sans-serif;
  }

  .hero-scroll svg {
    animation: heroBob 2.1s ease-in-out infinite;
  }

  @keyframes heroBob {
    0%,
    100% {
      transform: translateY(0);
    }
    50% {
      transform: translateY(7px);
    }
  }
</style>
