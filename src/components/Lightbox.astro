---
// No props — this component manages itself via JS.
// Place once in the page layout, outside all sections.
---

<div
  id="project-dialog"
  class="lightbox"
  role="dialog"
  aria-modal="true"
  aria-label="Image"
  hidden
>
  <div class="lb-backdrop" id="lb-backdrop"></div>

  <button class="lb-btn lb-close" id="lb-close" aria-label="Fermer">
    <svg width="18" height="18" viewBox="0 0 24 24" fill="none">
      <path
        d="M6 6l12 12M18 6L6 18"
        stroke="currentColor"
        stroke-width="1.8"
        stroke-linecap="round"></path>
    </svg>
  </button>

  <button class="lb-btn lb-prev" id="prev-project" aria-label="Précédent">
    <svg width="20" height="20" viewBox="0 0 24 24" fill="none">
      <path
        d="M15 5l-7 7 7 7"
        stroke="currentColor"
        stroke-width="1.8"
        stroke-linecap="round"
        stroke-linejoin="round"></path>
    </svg>
  </button>

  <button class="lb-btn lb-next" id="next-project" aria-label="Suivant">
    <svg width="20" height="20" viewBox="0 0 24 24" fill="none">
      <path
        d="M9 5l7 7-7 7"
        stroke="currentColor"
        stroke-width="1.8"
        stroke-linecap="round"
        stroke-linejoin="round"></path>
    </svg>
  </button>

  <div class="lb-content">
    <div id="modal-loader" class="loader"></div>
    <img id="modal-image" src="" alt="" class="lb-image" />
    <div class="lb-meta">
      <div class="lb-cat" id="lb-cat"></div>
      <h3 class="lb-title" id="modal-title"></h3>
      <p class="lb-desc" id="lb-desc"></p>
    </div>
  </div>
</div>

<script>
  import { gsap } from 'gsap';
  interface LbItem {
    src: string;
    title: string;
    desc: string;
    credit: string;
    cat: string;
  }

  let items: LbItem[] = [];
  let current = 0;
  let isLoading = false;

  function buildItems() {
    const triggers = document.querySelectorAll<HTMLElement>('.project-trigger');
    items = Array.from(triggers).map((el) => ({
      src: el.dataset.image ?? '',
      title: el.dataset.title ?? '',
      desc: el.dataset.description ?? '',
      credit: el.dataset.credit ?? '',
      cat:
        el.closest('section')?.querySelector('h2')?.textContent?.trim() ?? '',
    }));
  }

  function render(idx: number) {
    const it = items[idx];
    if (!it) return;
    const img = document.getElementById('modal-image') as HTMLImageElement;
    const loader = document.getElementById('modal-loader') as HTMLElement;
    const prevBtn = document.getElementById(
      'prev-project'
    ) as HTMLButtonElement;
    const nextBtn = document.getElementById(
      'next-project'
    ) as HTMLButtonElement;

    isLoading = true;
    gsap.set(img, { opacity: 0, scale: 1.05, y: 20 });
    gsap.set('.lb-meta', { opacity: 0, y: 15 });
    loader.style.display = 'block';
    if (prevBtn) prevBtn.style.pointerEvents = 'none';
    if (nextBtn) nextBtn.style.pointerEvents = 'none';

    const onDone = () => {
      isLoading = false;
      loader.style.display = 'none';
      if (prevBtn) prevBtn.style.pointerEvents = 'auto';
      if (nextBtn) nextBtn.style.pointerEvents = 'auto';

      gsap.to(img, {
        opacity: 1,
        scale: 1,
        y: 0,
        duration: 0.6,
        ease: 'power3.out',
      });
      gsap.to('.lb-meta', {
        opacity: 1,
        y: 0,
        duration: 0.6,
        delay: 0.1,
        ease: 'power3.out',
      });
    };

    img.onload = onDone;
    img.onerror = onDone;

    img.src = it.src;

    if (img.complete) {
      onDone();
    }

    img.alt = it.title;
    (document.getElementById('lb-cat') as HTMLElement).textContent = it.cat;
    (document.getElementById('modal-title') as HTMLElement).textContent =
      it.title;
    (document.getElementById('lb-desc') as HTMLElement).textContent = it.desc;
  }

  function open(idx: number) {
    current = idx;
    buildItems();
    const lb = document.getElementById('project-dialog')!;
    lb.hidden = false;
    lb.removeAttribute('hidden');
    document.body.style.overflow = 'hidden';

    gsap.fromTo(
      lb,
      { opacity: 0 },
      { opacity: 1, duration: 0.4, ease: 'power2.out' }
    );

    render(current);
  }

  function close() {
    const lb = document.getElementById('project-dialog')!;
    gsap.to(lb, {
      opacity: 0,
      duration: 0.3,
      ease: 'power2.in',
      onComplete: () => {
        lb.hidden = true;
        document.body.style.overflow = '';
      },
    });
  }

  function step(n: number) {
    if (isLoading) return;
    current = (((current + n) % items.length) + items.length) % items.length;
    render(current);
  }

  // Wire triggers
  function init() {
    buildItems();
    document
      .querySelectorAll<HTMLElement>('.project-trigger')
      .forEach((el, idx) => {
        el.addEventListener('click', () => open(idx));
      });

    // Close on backdrop or image click
    document
      .getElementById('project-dialog')
      ?.addEventListener('click', (e) => {
        const t = e.target as HTMLElement;
        if (t.closest('.lb-btn')) return; // buttons handled
        if (t.closest('.lb-meta')) return; // let text be selectable
        close();
      });

    document.getElementById('lb-close')?.addEventListener('click', close);

    document
      .getElementById('prev-project')
      ?.addEventListener('click', () => step(-1));
    document
      .getElementById('next-project')
      ?.addEventListener('click', () => step(1));
    document.addEventListener('keydown', (e) => {
      if (document.getElementById('project-dialog')?.hidden || isLoading)
        return;
      if (e.key === 'Escape') close();
      if (e.key === 'ArrowLeft') step(-1);
      if (e.key === 'ArrowRight') step(1);
    });
  }

  document.addEventListener('DOMContentLoaded', init);
  document.addEventListener('astro:after-swap', init);
</script>

<style>
  .lightbox {
    position: fixed;
    inset: 0;
    z-index: 100;
    display: flex;
    align-items: center;
    justify-content: center;
    padding: clamp(20px, 5vh, 64px);
  }

  .lightbox[hidden] {
    display: none;
  }

  .lb-backdrop {
    position: absolute;
    inset: 0;
    background: rgba(6, 6, 8, 0.94);
    backdrop-filter: blur(8px);
    -webkit-backdrop-filter: blur(8px);
  }

  .lb-btn {
    position: absolute;
    z-index: 2;
    display: flex;
    align-items: center;
    justify-content: center;
    background: rgba(255, 255, 255, 0.04);
    border: 1px solid rgba(255, 255, 255, 0.16);
    border-radius: 50%;
    color: #fff;
    cursor: pointer;
    transition: background 0.2s;
  }
  .lb-btn:hover {
    background: rgba(255, 255, 255, 0.12);
  }

  .lb-close {
    top: 24px;
    right: 28px;
    width: 46px;
    height: 46px;
    font-size: 20px;
  }
  .lb-prev {
    left: max(16px, 2vw);
    top: 50%;
    transform: translateY(-50%);
    width: 52px;
    height: 52px;
  }
  .lb-next {
    right: max(16px, 2vw);
    top: 50%;
    transform: translateY(-50%);
    width: 52px;
    height: 52px;
  }

  .lb-content {
    position: relative;
    z-index: 1;
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: 18px;
    max-width: 1100px;
    width: 100%;
  }

  .lb-image {
    max-width: 100%;
    max-height: 72vh;
    object-fit: contain;
    border-radius: 4px;
    box-shadow: 0 30px 90px rgba(0, 0, 0, 0.6);
  }

  .loader {
    display: none;
    width: 50px;
    height: 50px;
    border: 3px solid rgba(255, 255, 255, 0.1);
    border-radius: 50%;
    border-top-color: #fff;
    animation: spin 1s linear infinite;
    position: absolute;
    top: 50%;
    left: 50%;
    margin-top: -25px;
    margin-left: -25px;
    z-index: 5;
  }

  @keyframes spin {
    to {
      transform: rotate(360deg);
    }
  }

  .lb-meta {
    text-align: center;
  }

  .lb-cat {
    color: #d4d4d8;
    font-size: 11px;
    font-weight: 600;
    letter-spacing: 0.28em;
    margin-bottom: 9px;
    text-transform: uppercase;
  }

  .lb-title {
    margin: 0 0 8px;
    color: #fff;
    font-size: clamp(20px, 2.4vw, 26px);
    font-weight: 700;
  }

  .lb-desc {
    margin: 0 0 6px;
    color: #9a9aa1;
    font-size: 14.5px;
    font-weight: 300;
    max-width: 620px;
  }
</style>
