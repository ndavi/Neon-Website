---
import { getLangFromUrl, useTranslations } from '../i18n/utils';

const lang = getLangFromUrl(Astro.url);
const t = useTranslations(lang);
---
<div id="intro-text" class="intro-description mx-auto px-4 pb-16">
  <p>
    {t('intro.p1')}
    <br />{t('intro.p2')}
  </p>
</div>

<style>
  .intro-description {
    font-family: "M PLUS Rounded 1c", sans-serif;
    font-weight: 300;
    text-align: center;
    justify-content: center;
    padding-top: 2vh;
    font-size: 1.4rem;
    color: black;
  }
</style>
