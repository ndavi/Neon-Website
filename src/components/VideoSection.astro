---
import SectionHeader from './SectionHeader.astro';
import { VIDEOS } from '../config/site';
---
<section id="videos" class="video py-10">
  <SectionHeader title="VIDEOS" pictoClass="picto-v" description="Capsules vidéos et aftermovies." />

  <div class="video-grid flex flex-wrap justify-center gap-4 px-4 max-w-350 mx-auto">
    {VIDEOS.map((vid) => (
      <div class="player-wrapper w-full md:w-[45%] lg:w-[30%] aspect-video">
        <iframe 
          width="100%" 
          height="100%" 
          src={vid.url} 
          title={vid.alt} 
          loading="lazy"
          allow="accelerometer; autoplay; clipboard-write; encrypted-media; gyroscope; picture-in-picture" 
          allowfullscreen
          class="p-2 border-0"
        ></iframe>
      </div>
    ))}
  </div>
</section>
