---
import { VIDEOS } from '../config/site';
---

<section id="videos" class="project-section">
  <!-- LEFT: sticky category panel -->
  <div class="section-panel">
    <div class="panel-meta">
      <span class="panel-line" aria-hidden="true"></span>
    </div>
    <h2 class="panel-title">VIDEOS</h2>
    <p class="panel-desc">Capsules vidéos et aftermovies.</p>
  </div>

  <!-- RIGHT: video gallery -->
  <div class="section-gallery">

  <div class="video-grid">
    {
      VIDEOS.map((vid) => (
        <div class="player-wrapper">
          <iframe
            width="100%"
            height="100%"
            src={vid.url}
            title={vid.alt}
            loading="lazy"
            allow="accelerometer; autoplay; clipboard-write; encrypted-media; gyroscope; picture-in-picture"
            allowfullscreen
          />
        </div>
      ))
    }
  </div>
  </div>
</section>

<style>
  .project-section {
    display: grid;
    grid-template-columns: minmax(150px, 210px) 1fr;
    gap: clamp(26px, 3.5vw, 64px);
    padding: clamp(44px, 7vh, 84px) 0;
    border-bottom: 1px solid rgba(255, 255, 255, 0.08);
  }

  .section-panel {
    position: sticky;
    top: 88px;
    align-self: start;
    height: max-content;
  }

  .panel-meta {
    display: flex;
    align-items: baseline;
    gap: 12px;
    margin-bottom: 18px;
  }

  .panel-line {
    flex: 1;
    height: 1px;
    background: rgba(255, 255, 255, 0.14);
  }

  .panel-title {
    margin: 0 0 16px;
    font-size: clamp(22px, 2.4vw, 30px);
    font-weight: 700;
    line-height: 1.1;
    color: #fff;
  }

  .panel-desc {
    margin: 0;
    font-size: 14.5px;
    font-weight: 300;
    line-height: 1.6;
    color: #8e8e96;
  }

  .section-gallery {
    display: flex;
    flex-direction: column;
    gap: clamp(14px, 1.7vw, 22px);
  }

  .video-grid {
    display: flex;
    flex-direction: row;
    flex-wrap: wrap;
    justify-content: center;
    padding: 0;
  }

  .player-wrapper {
    position: relative;
    transition: 0.4s;
    text-align: center;
    padding: 1.5vh;
    box-sizing: border-box;
  }

  iframe {
    width: 100%;
    height: 100%;
    padding: 0 2.5%;
    object-fit: cover;
    border: 0;
    box-sizing: border-box;
  }

  .player-wrapper:hover {
    transform: scale(0.98);
    opacity: 0.7;
  }

  @media screen and (min-width: 769px) {
    .player-wrapper {
      width: calc(100vw / 3.5);
      height: calc(100vh / 3.5);
    }
  }

  @media screen and (min-width: 481px) and (max-width: 768px) {
    .player-wrapper {
      width: calc(100vw / 3);
      height: calc(100vh / 3);
    }
  }

  @media screen and (min-width: 321px) and (max-width: 480px) {
    .player-wrapper {
      width: 50vw;
      height: 30vh;
    }
  }
</style>
