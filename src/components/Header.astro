---
import { getLangFromUrl, useTranslations } from '../i18n/utils';
import neonLogo from '../assets/img/neonAssets/neon-white-sans-baseline.png';

const lang = getLangFromUrl(Astro.url);
const t = useTranslations(lang);

const navItems = [
  { id: 'stage-design', label: t('nav.stage-design') },
  { id: 'on-tour', label: t('nav.on-tour') },
  { id: 'conception-3d', label: t('nav.conception-3d') },
  { id: 'videos', label: t('nav.videos') },
  { id: 'arts-numeriques', label: t('nav.arts-numeriques') },
];
---

<header class="site-header header-container" id="site-header">
  <a href={`/${lang}/`} class="header-logo" aria-label="NEON — retour accueil">
    <img
      src={neonLogo.src}
      alt="NEON — Stage Design & Arts Numériques"
      width={neonLogo.width}
      height={neonLogo.height}
      class="logo-img"
      loading="eager"
    />
  </a>

  <nav class="header-nav" aria-label="Navigation principale">
    {
      navItems.map((item) => (
        <a href={`/${lang}/#${item.id}`} class="nav-link">
          {item.label}
        </a>
      ))
    }
  </nav>

  <div class="header-right">
    <div class="lang-switcher" role="navigation" aria-label="Langue">
      <a href="/fr/" class={`lang-link ${lang === 'fr' ? 'active' : ''}`}>FR</a>
      <span class="lang-sep" aria-hidden="true">|</span>
      <a href="/en/" class={`lang-link ${lang === 'en' ? 'active' : ''}`}>EN</a>
    </div>
  </div>
</header>

<script>
  import { gsap } from 'gsap';

  function initMagneticLinks() {
    const links = document.querySelectorAll('.nav-link, .lang-link') as NodeListOf<HTMLElement>;
    
    links.forEach((link) => {
      link.addEventListener('mousemove', (e: MouseEvent) => {
        const rect = link.getBoundingClientRect();
        // Calculate distance from center of element
        const x = e.clientX - (rect.left + rect.width / 2);
        const y = e.clientY - (rect.top + rect.height / 2);
        
        // Move element towards mouse (using a smaller multiplier for subtlety)
        gsap.to(link, {
          x: x * 0.15,
          y: y * 0.15,
          duration: 0.3,
          ease: 'power2.out',
        });
      });
      
      link.addEventListener('mouseleave', () => {
        // Reset position
        gsap.to(link, {
          x: 0,
          y: 0,
          duration: 0.7,
          ease: 'elastic.out(1, 0.3)',
        });
      });
    });
  }

  document.addEventListener('DOMContentLoaded', initMagneticLinks);
  document.addEventListener('astro:after-swap', initMagneticLinks);
</script>

<!-- Mobile menu trigger (to be implemented) -->

<style>
  .site-header {
    position: fixed;
    top: 0;
    left: 0;
    right: 0;
    z-index: 50;
    display: flex;
    align-items: center;
    justify-content: space-between;
    padding: 16px clamp(20px, 5vw, 64px);
    background: rgba(10, 10, 11, 0.55);
    backdrop-filter: blur(14px);
    -webkit-backdrop-filter: blur(14px);
    border-bottom: 1px solid rgba(255, 255, 255, 0.07);
    gap: 24px;
  }

  .header-logo {
    display: flex;
    align-items: center;
    flex-shrink: 0;
  }

  .logo-img {
    height: 36px;
    width: auto;
    display: block;
  }

  .header-nav {
    display: flex;
    align-items: center;
    gap: clamp(16px, 2.2vw, 32px);
    flex-wrap: nowrap;
  }

  .nav-link {
    color: #b6b6bd;
    font-size: 12.5px;
    font-weight: 500;
    letter-spacing: 0.14em;
    transition: color 0.25s;
    white-space: nowrap;
    display: inline-block; /* Needed for transform */
    padding: 10px; /* Expand hover area */
    margin: -10px;
  }
  .nav-link:hover {
    color: #fff;
  }

  .header-right {
    display: flex;
    align-items: center;
    gap: 16px;
    flex-shrink: 0;
  }

  .lang-switcher {
    display: flex;
    align-items: center;
    gap: 7px;
  }

  .lang-sep {
    color: rgba(255, 255, 255, 0.18);
    font-size: 12px;
  }

  .lang-link {
    color: #67676e;
    font-size: 13px;
    font-weight: 400;
    letter-spacing: 0.1em;
    transition: color 0.2s;
    padding: 10px 5px; /* Expand hover area */
    margin: -8px 0;
    display: inline-block; /* Needed for transform */
  }
  .lang-link:hover {
    color: #fff;
  }
  .lang-link.active {
    color: #fff;
    font-weight: 700;
  }

  @media (max-width: 768px) {
    .header-nav {
      display: none;
    }
  }
</style>
