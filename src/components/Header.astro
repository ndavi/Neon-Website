---
import { getLangFromUrl, useTranslations } from '../i18n/utils';

const lang = getLangFromUrl(Astro.url);
const t = useTranslations(lang);

const navItems = [
  { id: 'stage-design', name: t('nav.stage-design') },
  { id: 'on-tour', name: t('nav.on-tour') },
  { id: 'arts-numeriques', name: t('nav.arts-numeriques') },
  { id: 'conception-3d', name: t('nav.conception-3d') },
  { id: 'videos', name: t('nav.videos') },
];
---
<div id="description" class="header-container hidden lg:flex py-12">
  {navItems.map((item, index) => (
    <>
      <div class="header-item">
        <a href={`/${lang}/#${item.id}`}><p>{item.name}</p></a>
      </div>
      {index < navItems.length - 1 && <div class="vl"></div>}
    </>
  ))}
  <div class="vl"></div>
  <div class="header-item lang-switcher">
    <a href="/fr/" class={lang === 'fr' ? 'active' : ''}>FR</a>
    <span>|</span>
    <a href="/en/" class={lang === 'en' ? 'active' : ''}>EN</a>
  </div>
</div>

<style>
  .header-container {
    display: flex;
    flex-direction: row;
    flex-wrap: nowrap;
    justify-content: space-around;
    align-items: center;
    align-content: center;
    margin: 0rem 5rem 0rem 5rem;
  }

  .header-item {
    font-family: "M PLUS Rounded 1c", sans-serif;
    font-weight: 500;
    font-size: 1.4rem;
    display: block;
    flex-grow: 0;
    flex-shrink: 1;
    flex-basis: auto;
    align-self: auto;
    order: 0;
  }

  .header-item a {
    text-decoration: none;
    color: black;
    font-style: normal;
  }

  .header-item p {
    display: inline-block;
    position: relative;
    cursor: pointer;
    margin: 0;
  }

  .header-item p::after {
    content: '';
    position: absolute;
    width: 100%;
    transform: scaleX(0);
    height: 2px;
    bottom: 0;
    left: 0;
    background-color: #000000;
    transform-origin: center;
    transition: transform 0.25s ease-in-out;
  }

  .header-item p:hover::after {
    transform: scaleX(1);
    transform-origin: center;
  }

  .lang-switcher {
    font-size: 1.1rem;
    display: flex;
    gap: 0.5rem;
    align-items: center;
  }

  .lang-switcher a {
    opacity: 0.4;
    transition: opacity 0.2s;
  }

  .lang-switcher a.active {
    opacity: 1;
    font-weight: 700;
  }

  .lang-switcher a:hover {
    opacity: 1;
  }

  .vl {
    border-left: 1px solid black;
    height: 1.5rem;
  }

  @media screen and (max-width: 1000px) {
    .header-container {
      display: none;
    }
  }
</style>
