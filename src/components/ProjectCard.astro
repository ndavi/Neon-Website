---
import type { CollectionEntry } from 'astro:content';
import { getLangFromUrl, useTranslations } from '../i18n/utils';

interface Props {
  project:
    | CollectionEntry<'stage-design'>
    | CollectionEntry<'on-tour'>
    | CollectionEntry<'arts-numeriques'>
    | CollectionEntry<'conception-3d'>;
  loading?: 'lazy' | 'eager';
}

const { project, loading = 'lazy' } = Astro.props;
const lang = getLangFromUrl(Astro.url);
const t = useTranslations(lang);
const { title, description, coverImage, credit, lienCredit, alt } =
  project.data;

const tTitle = title[lang];
const tDescription = description ? description[lang] : '';
const tAlt = alt ? alt[lang] : '';
const tYear = project.data.date
  ? new Date(project.data.date).getFullYear().toString()
  : '';
---

<button
  class="project-card project-trigger is-loading"
  data-title={tTitle}
  data-description={tDescription}
  data-image={coverImage.src}
  data-credit={credit}
  data-lien-credit={lienCredit}
  data-alt={tAlt}
  type="button"
>
  <div class="card-img-wrap">
    <div class="loader"></div>
    <div class="parallax-wrap">
      <img
        src={coverImage.src}
        width={coverImage.width}
        height={coverImage.height}
        alt={tAlt || tTitle}
        loading={loading}
        class="card-img"
      />
    </div>
  </div>
  <div class="card-caption">
    <span class="card-title">{tTitle}</span>
    <span class="card-year">{tYear}</span>
  </div>

  <!-- SEO / accessibility -->
  <div class="sr-only">
    <h4>{tTitle}</h4>
    <p>{tDescription}</p>
    {
      credit && (
        <p>
          {t('project.credit')} {credit}
        </p>
      )
    }
  </div>
</button>

<style>
  .project-card {
    display: block;
    text-align: left;
    padding: 0;
    margin: 0;
    border: 0;
    background: none;
    cursor: pointer;
    font-family: 'M PLUS Rounded 1c', sans-serif;
  }

  .card-img-wrap {
    position: relative;
    overflow: hidden;
    background: #141417;
    border-radius: 3px;
    transition:
      transform 0.5s ease-out,
      box-shadow 0.5s ease-out;
    will-change: transform;
  }

  .project-card:hover .card-img-wrap {
    box-shadow:
      0 0 30px rgba(212, 212, 216, 0.15),
      0 0 12px rgba(212, 212, 216, 0.1);
  }

  .parallax-wrap {
    transform: scale(1.3);
    transform-origin: center;
    width: 100%;
    height: 100%;
  }

  .loader {
    display: none;
    width: 40px;
    height: 40px;
    border: 3px solid rgba(255, 255, 255, 0.3);
    border-radius: 50%;
    border-top-color: #fff;
    animation: spin 1s linear infinite;
    position: absolute;
    top: 50%;
    left: 50%;
    margin-top: -20px;
    margin-left: -20px;
    z-index: 10;
  }

  .is-loading {
    pointer-events: none;
  }

  .is-loading .loader {
    display: block;
  }

  @keyframes spin {
    to {
      transform: rotate(360deg);
    }
  }

  .card-img {
    width: 100%;
    height: auto;
    object-fit: cover;
    display: block;
    transition:
      transform 0.7s cubic-bezier(0.2, 0.7, 0.2, 1),
      filter 0.4s;
    filter: saturate(1.02);
  }

  .project-card:hover .card-img {
    transform: scale(1.05);
  }

  .card-caption {
    display: flex;
    align-items: baseline;
    justify-content: space-between;
    gap: 12px;
    padding: 11px 2px 0;
  }

  .card-title {
    color: #dcdce0;
    font-size: 13.5px;
    font-weight: 500;
  }

  .card-year {
    color: #5f5f66;
    font-size: 11px;
    font-weight: 400;
    white-space: nowrap;
    flex-shrink: 0;
  }
</style>

<script>
  import { gsap } from 'gsap';
  import { ScrollTrigger } from 'gsap/ScrollTrigger';

  gsap.registerPlugin(ScrollTrigger);

  let ctx: gsap.Context;

  function initParallax() {
    if (ctx) ctx.revert();

    ctx = gsap.context(() => {
      const cards = document.querySelectorAll('.project-card, .featured-card');
      cards.forEach((card) => {
        const parallaxWrap = card.querySelector('.parallax-wrap');
        if (parallaxWrap) {
          gsap.fromTo(
            parallaxWrap,
            { yPercent: -15 },
            {
              yPercent: 15,
              ease: 'none',
              scrollTrigger: {
                trigger: card,
                start: 'top bottom',
                end: 'bottom top',
                scrub: true,
              },
            }
          );
        }
      });
    });
  }

  function initProjectLoaders() {
    const triggers = document.querySelectorAll('.project-trigger');
    triggers.forEach((trigger) => {
      const img = trigger.querySelector('img');
      if (img) {
        const removeLoading = () => {
          trigger.classList.remove('is-loading');
          // Refresh ScrollTrigger to recalculate heights when image loads
          ScrollTrigger.refresh();
        };

        if (img.complete) {
          removeLoading();
        } else {
          img.addEventListener('load', removeLoading);
          img.addEventListener('error', removeLoading);
        }
      }
    });
  }

  function initTiltEffect() {
    const cards = document.querySelectorAll(
      '.project-card, .featured-card'
    ) as NodeListOf<HTMLElement>;
    cards.forEach((card) => {
      const imgWrap = card.querySelector(
        '.card-img-wrap, .featured-img-wrap'
      ) as HTMLElement;
      if (!imgWrap) return;

      card.addEventListener('mousemove', (e: MouseEvent) => {
        const rect = card.getBoundingClientRect();
        const x = e.clientX - rect.left;
        const y = e.clientY - rect.top;

        const centerX = rect.width / 2;
        const centerY = rect.height / 2;

        // Normalize the tilt so it feels identical regardless of card size.
        // We aim for a maximum Z-displacement of ~6 pixels at the edges.
        const maxDisplacement = 6;
        const maxRotateX = (maxDisplacement / centerY) * (180 / Math.PI);
        const maxRotateY = (maxDisplacement / centerX) * (180 / Math.PI);

        const rotateX = ((y - centerY) / centerY) * -maxRotateX;
        const rotateY = ((x - centerX) / centerX) * maxRotateY;

        imgWrap.style.transform = `perspective(1000px) rotateX(${rotateX}deg) rotateY(${rotateY}deg)`;
        imgWrap.style.transition = 'box-shadow 0.5s ease-out';
      });

      card.addEventListener('mouseleave', () => {
        imgWrap.style.transform = `perspective(1000px) rotateX(0deg) rotateY(0deg)`;
        imgWrap.style.transition =
          'transform 0.5s ease-out, box-shadow 0.5s ease-out';
      });
    });
  }

  document.addEventListener('DOMContentLoaded', () => {
    initParallax();
    initProjectLoaders();
    initTiltEffect();
  });

  document.addEventListener('astro:after-swap', () => {
    initParallax();
    initProjectLoaders();
    initTiltEffect();
  });
</script>
