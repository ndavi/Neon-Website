---
import { Picture } from 'astro:assets';
import type { CollectionEntry } from 'astro:content';
import { getLangFromUrl, useTranslations } from '../i18n/utils';

interface Props {
  project:
    | CollectionEntry<'stage-design'>
    | CollectionEntry<'on-tour'>
    | CollectionEntry<'arts-numeriques'>
    | CollectionEntry<'conception-3d'>;
  loading?: 'lazy' | 'eager';
}

const { project, loading = 'lazy' } = Astro.props;
const lang = getLangFromUrl(Astro.url);
const t = useTranslations(lang);
const { title, description, coverImage, credit, lienCredit, alt } =
  project.data;

const tTitle = title[lang];
const tDescription = description ? description[lang] : '';
const tAlt = alt ? alt[lang] : '';
const tYear = project.data.date
  ? new Date(project.data.date).getFullYear().toString()
  : '';
---

<button
  class="project-card project-trigger is-loading"
  data-title={tTitle}
  data-description={tDescription}
  data-image={coverImage}
  data-credit={credit}
  data-lien-credit={lienCredit}
  data-alt={tAlt}
  type="button"
>
  <div class="card-img-wrap">
    <div class="loader"></div>
    <Picture
      src={coverImage}
      formats={['avif', 'webp']}
      alt={tAlt || tTitle}
      width={800}
      height={600}
      widths={[400, 800]}
      sizes="(max-width: 768px) 50vw, 400px"
      loading={loading}
      class="card-img"
    />
  </div>
  <div class="card-caption">
    <span class="card-title">{tTitle}</span>
    <span class="card-year">{tYear}</span>
  </div>

  <!-- SEO / accessibility -->
  <div class="sr-only">
    <h4>{tTitle}</h4>
    <p>{tDescription}</p>
    {
      credit && (
        <p>
          {t('project.credit')} {credit}
        </p>
      )
    }
  </div>
</button>

<style>
  .project-card {
    display: block;
    text-align: left;
    padding: 0;
    margin: 0;
    border: 0;
    background: none;
    cursor: pointer;
    font-family: 'M PLUS Rounded 1c', sans-serif;
  }

  .card-img-wrap {
    position: relative;
    aspect-ratio: 4 / 3;
    overflow: hidden;
    background: #141417;
    border-radius: 3px;
  }

  .loader {
    display: none;
    width: 40px;
    height: 40px;
    border: 3px solid rgba(255, 255, 255, 0.3);
    border-radius: 50%;
    border-top-color: #fff;
    animation: spin 1s linear infinite;
    position: absolute;
    top: 50%;
    left: 50%;
    margin-top: -20px;
    margin-left: -20px;
    z-index: 10;
  }

  .is-loading {
    pointer-events: none;
  }

  .is-loading .loader {
    display: block;
  }

  @keyframes spin {
    to {
      transform: rotate(360deg);
    }
  }

  .card-img {
    width: 100%;
    height: 100%;
    object-fit: cover;
    display: block;
    transition:
      transform 0.7s cubic-bezier(0.2, 0.7, 0.2, 1),
      filter 0.4s;
    filter: saturate(1.02);
  }

  .project-card:hover .card-img {
    transform: scale(1.05);
  }

  .card-caption {
    display: flex;
    align-items: baseline;
    justify-content: space-between;
    gap: 12px;
    padding: 11px 2px 0;
  }

  .card-title {
    color: #dcdce0;
    font-size: 13.5px;
    font-weight: 500;
  }

  .card-year {
    color: #5f5f66;
    font-size: 11px;
    font-weight: 400;
    white-space: nowrap;
    flex-shrink: 0;
  }
</style>

<script>
  function initProjectLoaders() {
    const triggers = document.querySelectorAll('.project-trigger');
    triggers.forEach((trigger) => {
      const img = trigger.querySelector('img');
      if (img) {
        const removeLoading = () => trigger.classList.remove('is-loading');

        if (img.complete) {
          removeLoading();
        } else {
          img.addEventListener('load', removeLoading);
          img.addEventListener('error', removeLoading);
        }
      }
    });
  }

  document.addEventListener('DOMContentLoaded', initProjectLoaders);
  document.addEventListener('astro:after-swap', initProjectLoaders);
</script>
