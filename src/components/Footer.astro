---
import { SITE_NAME } from '../config/site';
import { getLangFromUrl, useTranslations } from '../i18n/utils';

const lang = getLangFromUrl(Astro.url);
const t = useTranslations(lang);
---

<footer class="site-footer" id="contact">
  <div class="footer-inner">
    <span class="footer-eyebrow">CONTACT</span>

    <a href="mailto:contact@neon-live.fr" class="footer-email">
      contact@neon-live.fr
    </a>

    <div class="footer-phones">
      <span>+33 6 32 63 23 30</span>
      <span class="sep" aria-hidden="true">·</span>
      <span>+33 6 01 45 16 44</span>
    </div>
    <p class="footer-address">4 rue Alexis Perroncel, 69100 Villeurbanne</p>

    <div class="footer-socials">
      <a
        href="https://www.facebook.com/NeonLiveFR"
        target="_blank"
        rel="noreferrer"
        aria-label="Facebook"
        class="social-link"
      >
        <svg width="19" height="19" fill="currentColor" viewBox="0 0 16 16"
          ><path
            d="M16 8.049c0-4.446-3.582-8.05-8-8.05C3.58 0-.002 3.603-.002 8.05c0 4.017 2.926 7.347 6.75 7.951v-5.625h-2.03V8.05H6.75V6.275c0-2.017 1.195-3.131 3.022-3.131.876 0 1.791.157 1.791.157v1.98h-1.009c-.993 0-1.303.621-1.303 1.258v1.51h2.218l-.354 2.326H9.25V16c3.824-.604 6.75-3.934 6.75-7.951z"
          ></path></svg
        >
      </a>
      <a
        href="https://www.instagram.com/neonlivefr/"
        target="_blank"
        rel="noreferrer"
        aria-label="Instagram"
        class="social-link"
      >
        <svg width="19" height="19" fill="currentColor" viewBox="0 0 16 16"
          ><path
            d="M8 0C5.829 0 5.556.01 4.703.048 3.85.088 3.269.222 2.76.42a3.917 3.217 0 0 0-1.417.923A3.927 3.917 0 0 0 .42 2.76c-.198.509-.333 1.09-.373 1.942C.01 5.556 0 5.829 0 8s.01 2.444.048 3.297c.04.852.174 1.433.372 1.942.205.526.478.972.923 1.417.444.445.89.719 1.416.923.51.198 1.09.333 1.942.372C5.555 15.99 5.828 16 8 16s2.444-.01 3.298-.048c.851-.04 1.434-.174 1.943-.372a3.916 3.916 0 0 0 1.416-.923c.445-.445.718-.891.923-1.417.197-.509.332-1.09.372-1.942C15.99 10.445 16 10.172 16 8s-.01-2.445-.048-3.299c-.04-.851-.175-1.433-.372-1.941a3.926 3.926 0 0 0-.923-1.417A3.911 3.911 0 0 0 13.24.42c-.51-.198-1.092-.333-1.943-.372C10.443.01 10.172 0 7.998 0h.003zm-.717 1.442h.718c2.136 0 2.389.007 3.232.046.78.035 1.204.166 1.486.275.373.145.64.319.92.599.28.28.453.546.598.92.11.281.24.705.275 1.485.039.844.047 1.097.047 3.231s-.008 2.389-.047 3.232c-.035.78-.166 1.203-.275 1.485a2.47 2.47 0 0 1-.599.919c-.28.28-.546.453-.92.598-.282.11-.705.24-1.485.276-.843.038-1.096.047-3.232.047s-2.39-.009-3.233-.047c-.78-.036-1.203-.166-1.485-.276a2.478 2.478 0 0 1-.92-.598 2.48 2.48 0 0 1-.6-.92c-.109-.281-.24-.705-.275-1.485-.038-.843-.046-1.096-.046-3.233 0-2.136.008-2.388.046-3.231.036-.78.166-1.204.276-1.486.145-.373.319-.64.599-.92.28-.28.546-.453.92-.598.282-.11.705-.24 1.485-.276.738-.034 1.024-.044 2.515-.045v.002zm4.988 1.328a.96.96 0 1 0 0 1.92.96.96 0 0 0 0-1.92zm-4.27 1.122a4.109 4.109 0 1 0 0 8.217 4.109 4.109 0 0 0 0-8.217zm0 1.441a2.667 2.667 0 1 1 0 5.334 2.667 2.667 0 0 1 0-5.334z"
          ></path></svg
        >
      </a>
      <a
        href="https://www.youtube.com/channel/UCmjHVA2_EfYHG3aaBCPnIfw/featured"
        target="_blank"
        rel="noreferrer"
        aria-label="YouTube"
        class="social-link"
      >
        <svg width="19" height="19" fill="currentColor" viewBox="0 0 16 16"
          ><path
            d="M8.051 1.999h.089c.822.003 4.987.033 6.11.335a2.01 2.01 0 0 1 1.415 1.42c.101.38.172.883.22 1.402l.01.104.022.26.008.104c.065.914.073 1.77.074 1.957v.075c-.001.194-.01 1.108-.082 2.06l-.008.105-.009.104c-.05.572-.124 1.14-.235 1.558a2.007 2.007 0 0 1-1.415 1.42c-1.16.312-5.569.334-6.18.335h-.142c-.309 0-1.587-.006-2.927-.052l-.17-.006-.087-.004-.171-.007-.171-.007c-1.11-.049-2.167-.128-2.654-.26a2.007 2.007 0 0 1-1.415-1.419c-.111-.417-.185-.986-.235-1.558L.09 9.82l-.008-.104A31.4 31.4 0 0 1 0 7.68v-.123c.002-.215.01-.958.064-1.778l.007-.103.003-.052.008-.104.022-.26.01-.104c.048-.519.119-1.023.22-1.402a2.007 2.007 0 0 1 1.415-1.42c.487-.13 1.544-.21 2.654-.26l.17-.007.172-.006.086-.003.171-.007A99.788 99.788 0 0 1 7.858 2h.193zM6.4 5.209v4.818l4.157-2.408L6.4 5.209z"
          ></path></svg
        >
      </a>
    </div>

    <div class="footer-bottom">
      <span class="footer-copy">© 2026 {SITE_NAME} LIVE</span>
      <span class="footer-sep" aria-hidden="true">·</span>
      <a href={`/${lang}/legal-mentions`} class="footer-legal"
        >{t('footer.legal')}</a
      >
    </div>
  </div>
</footer>

<style>
  .site-footer {
    border-top: 1px solid rgba(255, 255, 255, 0.09);
    padding: clamp(70px, 11vh, 120px) clamp(20px, 5vw, 64px) 40px;
    text-align: center;
    background: #0a0a0b;
  }

  .footer-inner {
    max-width: 1380px;
    margin: 0 auto;
  }

  .footer-eyebrow {
    display: block;
    color: #d4d4d8;
    font-size: 11px;
    font-weight: 600;
    letter-spacing: 0.34em;
    margin-bottom: 18px;
  }

  .footer-email {
    display: block;
    font-size: clamp(28px, 5vw, 64px);
    font-weight: 800;
    letter-spacing: -0.02em;
    color: #fff;
    transition: color 0.25s;
    margin-bottom: 24px;
    line-height: 1;
  }
  .footer-email:hover {
    color: #d4d4d8;
  }

  .footer-phones {
    display: flex;
    align-items: center;
    justify-content: center;
    gap: 12px;
    color: #9a9aa1;
    font-weight: 300;
    font-size: 15px;
    margin-bottom: 8px;
  }

  .sep {
    color: #5f5f66;
  }

  .footer-address {
    margin: 0 0 42px;
    color: #6f6f76;
    font-size: 13px;
    font-weight: 300;
  }

  .footer-socials {
    display: flex;
    justify-content: center;
    gap: 16px;
    margin-bottom: 42px;
  }

  .social-link {
    display: flex;
    align-items: center;
    justify-content: center;
    width: 46px;
    height: 46px;
    border-radius: 50%;
    border: 1px solid rgba(255, 255, 255, 0.14);
    color: #c8c8ce;
    transition:
      border-color 0.25s,
      color 0.25s;
  }
  .social-link:hover {
    border-color: rgba(212, 212, 216, 0.5);
    color: #fff;
  }

  .footer-bottom {
    display: flex;
    align-items: center;
    justify-content: center;
    gap: 14px;
    flex-wrap: wrap;
    padding-top: 30px;
    border-top: 1px solid rgba(255, 255, 255, 0.07);
  }

  .footer-copy {
    color: #5f5f66;
    font-size: 12.5px;
  }
  .footer-sep {
    color: #2f2f35;
  }

  .footer-legal {
    color: #8a8a90;
    font-size: 12.5px;
    transition: color 0.2s;
  }
  .footer-legal:hover {
    color: #fff;
  }
</style>
