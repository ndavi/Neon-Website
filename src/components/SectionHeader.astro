---
import { Image } from 'astro:assets';

interface Props {
  title: string;
  pictoClass?: string;
  description?: string;
  dark?: boolean;
}

const { title, pictoClass, description, dark = false } = Astro.props;
---

<div class="headercontainer">
  <div class="section-title">
    <h2 class={dark ? "text-dark" : ""}>{title}</h2>
    {pictoClass && (
      <div class={pictoClass}>
        <Image src="/img/neonAssets/picto1.png" width="24" height="20" alt="" />
      </div>
    )}
    <hr class={`section-hr ${dark ? "hr-dark" : ""}`} />
  </div>
</div>
{description && (
  <div class="section-description">
    <p class={dark ? "text-dark" : ""}>{description}</p>
  </div>
)}

<style>
  .section-title {
    font-family: "M PLUS Rounded 1c", sans-serif;
    font-weight: 700;
    font-size: 1.5rem;
    text-align: center;
    justify-content: center;
    position: relative;
    padding-top: 2vh;
    color: #0D0802;
    display: inline-block;
  }

  .section-title h2 {
    font-size: 2.25rem;
    margin: 0;
    padding: 0;
    font-weight: 700;
    line-height: 1.1;
    padding-bottom: 0.5rem;
  }

  /* Dark mode for dark backgrounds (like the original footer) */
  .text-dark {
    color: white !important;
  }

  .hr-dark {
    border-top-color: white !important;
  }

  .picto-sd, .picto-an, .picto-3d {
    position: absolute;
    top: 0;
    right: -20px;
  }

  .picto-v {
    position: absolute;
    top: 0;
    right: 5px;
  }

  .section-description {
    font-family: "M PLUS Rounded 1c", sans-serif;
    font-weight: 300;
    text-align: center;
    justify-content: center;
    padding-top: 2vh;
    padding-bottom: 10vh;
    font-size: 1.3rem;
  }

  .section-description p {
    margin: 0;
    padding: 0;
    font-size: inherit;
    font-weight: inherit;
  }

  hr {
    border: none;
    border-top: 2px solid #000000;
    overflow: visible;
    text-align: center;
    width: 40vw;
    margin: 1.5rem auto;
  }

  .section-hr {
    width: 200px;
  }

  .headercontainer {
    text-align: center;
  }
</style>
